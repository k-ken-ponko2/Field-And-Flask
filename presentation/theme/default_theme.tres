[gd_resource type="Theme" load_steps=2 format=3]

[sub_resource type="SystemFont" id="SystemFont_jp"]
font_names = PackedStringArray("Noto Sans CJK JP", "Noto Sans JP", "Yu Gothic", "Meiryo", "MS Gothic", "IPAGothic", "sans-serif")
allow_system_fallback = true

[resource]
default_font = SubResource("SystemFont_jp")
default_font_size = 15
